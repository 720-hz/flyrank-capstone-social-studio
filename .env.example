# SQLite file
DB_PATH=./social_studio.db

PORT=8000

# Discord bot (real) — create an application + bot at https://discord.com/developers/applications,
# invite it to a server you control with the "Send Messages" permission, then:
#   DISCORD_BOT_TOKEN  = the bot's token, from the Bot tab (NOT the client secret)
#   DISCORD_CHANNEL_ID  = right-click a text channel in that server -> Copy Channel ID
#                        (enable Developer Mode in Discord's Advanced settings first)
DISCORD_BOT_TOKEN=your-bot-token-here
DISCORD_CHANNEL_ID=your-channel-id-here

# How long (seconds) a 'processing' assignment is considered abandoned (crashed worker)
# and becomes reclaimable by the next worker run.
ASSIGNMENT_CLAIM_TIMEOUT_SECONDS=60
